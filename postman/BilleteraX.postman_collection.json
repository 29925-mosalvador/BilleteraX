{
  "info": {
    "name": "BilleteraX • REST y demostración WebSocket",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Laboratorio. Usar 00A/00B para usuario A y 00C/00D para emisor B; guardan sesión y cuenta automáticamente. Recargar B con 08B y transferir con 09. Ver docs/ACCESO_USUARIOS.md. reuseOperationId=true solo para repetir exactamente una solicitud."
  },
  "variable": [
    {
      "key": "operationId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.method === \"POST\" && (pm.environment.get(\"reuseOperationId\") !== \"true\" || !pm.collectionVariables.get(\"operationId\"))) {",
          "  pm.collectionVariables.set(\"operationId\", pm.variables.replaceIn(\"{{$guid}}\"));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00A Registrar mi usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"{{displayName}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Acceso correcto\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const session = pm.response.json();",
              "  pm.environment.set(\"tokenA\", session.token);",
              "  pm.environment.set(\"sourceAccount\", session.user.accountId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "00B Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Acceso correcto\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const session = pm.response.json();",
              "  pm.environment.set(\"tokenA\", session.token);",
              "  pm.environment.set(\"sourceAccount\", session.user.accountId);",
              "}"
            ]
          }
        }
      ]
    },
