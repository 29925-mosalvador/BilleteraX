# Copiar a /etc/billeterax/billeterax.env con permisos root:billeterax 0640.
# Sustituir todos los REPLACE; no versionar el archivo real.
SPRING_PROFILES_ACTIVE=debian
SERVER_ADDRESS=REPLACE_WITH_VERIFIED_DEBIAN_IP
SERVER_PORT=8080
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
WALLET_TOKEN_A=REPLACE_WITH_RANDOM_ACCOUNT_A_TOKEN
WALLET_TOKEN_B=REPLACE_WITH_RANDOM_ACCOUNT_B_TOKEN

# Origen exacto de GitHub Pages, sin la ruta /BilleteraX ni barra final.
WALLET_WEB_ORIGINS=https://29925-mosalvador.github.io

# Acceso público opcional: habilitar solo al aprovisionar el auxiliar HTTPS.
GATEWAY_ENABLED=false
GATEWAY_URL=
GATEWAY_AGENT_TOKEN=
GATEWAY_NODE_ID=debian-primary
