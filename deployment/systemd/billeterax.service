[Unit]
Description=BilleteraX Spring Boot laboratory backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=billeterax
Group=billeterax
WorkingDirectory=/var/lib/billeterax
EnvironmentFile=/etc/billeterax/billeterax.env
ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /opt/billeterax/billeterax.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/billeterax
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
